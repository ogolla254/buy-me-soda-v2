datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  username       String   @unique
  password       String
  paypalMe       String
  profilePicture String   @default("")
  bio            String   @default("")
  createdAt      DateTime @default(now())
  isSuspended    Boolean  @default(false)
}

model Event {
  id        String   @id @default(uuid())
  type      String
  path      String
  username  String?
  sodaCount Int?
  createdAt DateTime @default(now())
}
