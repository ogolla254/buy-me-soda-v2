datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String             @id @default(uuid())
  name             String
  email            String             @unique
  username         String             @unique
  password         String
  paypalMe         String
  profilePicture   String             @default("")
  bio              String             @default("")
  createdAt        DateTime           @default(now())
  isSuspended      Boolean            @default(false)
  transactions     Transaction[]      @relation("CreatorTransactions")
  messages         SupporterMessage[]
  withdrawals      Withdrawal[]
  passwordResets   PasswordResetCode[]
}

model Transaction {
  id                String   @id @default(uuid())
  creatorId         String
  amount            Float
  currency          String   @default("USD")
  sodaCount         Int
  supporterName     String?
  supporterEmail    String?
  message           String?
  provider          String   @default("manual")
  providerReference String?
  status            String   @default("pending")
  reference         String?  @unique
  feeAmount         Float    @default(0)
  netAmount         Float    @default(0)
  completedAt       DateTime?
  createdAt         DateTime @default(now())
  creator           User     @relation("CreatorTransactions", fields: [creatorId], references: [id], onDelete: Cascade)
}

model SupporterMessage {
  id             String   @id @default(uuid())
  creatorId      String
  supporterName  String?
  supporterEmail String?
  message        String
  transactionId  String?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
  creator        User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
}

model Withdrawal {
  id                String   @id @default(uuid())
  creatorId         String
  amount            Float
  currency          String   @default("USD")
  method            String
  destination      String
  providerReference String?
  status            String   @default("requested")
  note              String?
  processedAt       DateTime?
  createdAt         DateTime @default(now())
  creator           User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
}

model PasswordResetCode {
  id         String   @id @default(uuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  usedAt     DateTime?
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Event {
  id        String   @id @default(uuid())
  type      String
  path      String
  username  String?
  sodaCount Int?
  createdAt DateTime @default(now())
}
