datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String             @id @default(uuid())
  name           String
  email          String             @unique
  username       String             @unique
  password       String
  paypalMe       String
  profilePicture String             @default("")
  bio            String             @default("")
  createdAt      DateTime           @default(now())
  isSuspended    Boolean            @default(false)
  transactions   Transaction[]      @relation("CreatorTransactions")
  messages       SupporterMessage[]
}

model Transaction {
  id                String   @id @default(uuid())
  creatorId         String
  amount            Float
  currency          String   @default("USD")
  sodaCount         Int
  supporterName     String?
  supporterEmail    String?
  message           String?
  provider          String   @default("manual")
  providerReference String?
  status            String   @default("pending")
  feeAmount         Float    @default(0)
  netAmount         Float?
  reference         String?  @unique
  createdAt         DateTime @default(now())
  completedAt       DateTime?
  creator           User     @relation("CreatorTransactions", fields: [creatorId], references: [id], onDelete: Cascade)
}

model SupporterMessage {
  id             String   @id @default(uuid())
  creatorId      String
  supporterName  String?
  supporterEmail String?
  message        String
  transactionId  String?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
  creator        User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
}

model Event {
  id        String   @id @default(uuid())
  type      String
  path      String
  username  String?
  sodaCount Int?
  createdAt DateTime @default(now())
}
